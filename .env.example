# Is file ko copy karke ".env" naam do:   cp .env.example .env   (Windows: copy .env.example .env)
# .env kabhi GitHub pe push mat karna (.gitignore mein already hai).

# ⚠️ ZAROOR BADLO: lamba random string. Banane ke liye:
#    python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me-before-deploying-0000

# Database password (local ke liye chalega, server pe deploy karte waqt badlo)
POSTGRES_PASSWORD=codeclash

# Ek battle kitne second ki ho (900 = 15 minute). Testing ke liye 60 kar sakte ho.
BATTLE_DURATION_SECONDS=900
